module controller (
    input logic clk,
    input logic[6:0] op_code,
    input logic fun7,
    input logic[2:0] funct3,
    output logic[3:0] ALU_control_signal,
    output logic[1:0] ALUSrcA,
    output logic[1:0] ALUSrcB,
    output logic[1:0] ImmSrc,
    output logic[1:0] ResultSrc,
    output logic PCWrite,
    output logic AdrSrc,
    output logic MemWrite,
    output logic IRWrite,
    output logic RegWrite,
);
// not done brah

    typedef enum logic [2:0] { // set up fsm--will need to expand by instruction
        FETCH  = 3'b000,
        DECODE   = 3'b001,
        INSTR_RUN = 3'b010,
        MEMADR = 3'b011,
        MEMREAD = 3'b100,
        MEMWB = 3'b101
    } state_t;

    parameter LW_CODE = 7'b0000011;
    parameter ADDSUB_CODE = 7'b0110011;

    state_t state, next_state;

    always_ff @(posedge clk or posedge reset) begin
        if (reset) // Need to connect to DONE state somehow
            state <= FETCH;
        else
            state <= next_state;
    end

    always_ff@(posedge clk) begin // not sure if should be alwayscomb or posedge
        state <= next_state

        case (state)

            FETCH: begin
                next_state = DECODE; // write pc to old_pc
                AdrSrc => 0; // fetch adress from pc
                IRWrite => 1; // writes to instruction reg
                // we should be updating current instr right here
            end

            DECODE: begin
                next_state = INSTR_RUN; // no control signals needed
                //update the current instruction, 
                case (op_code)
                endcase
            end 

            INSTR_RUN: begin
                finished = 1'b1;
                if (reset)
                    next_state = IDLE;
            end

        endcase
    end

    always @(*) begin
        case (ALUOp, fun7, fun3)
            // R-type instructions
            4'b0010, 1'b0, 3'b000: ALU_control_signal = 4'b0010; // ADD
            4'b0010, 1'b1, 3'b000: ALU_control_signal = 4'b0110; // SUB
            4'b0010, 1'b0, 3'b111: ALU_control_signal = 4'b0000; // AND
            4'b0010, 1'b0, 3'b110: ALU_control_signal = 4'b0001; // OR
            4'b0010, 1'b0, 3'b100: ALU_control_signal = 4'b0011; // XOR
            4'b0010, 1'b0, 3'b001: ALU_control_signal = 4'b0100; // SLL
            4'b0010, 1'b0, 3'b101: ALU_control_signal = 4'b0101; // SRL
            4'b0010, 1'b1, 3'b101: ALU_control_signal = 4'b0111; // SRA

            // I-type instructions
            4'b0000, _, 3'b000: ALU_control_signal = 4'b0010; // ADDI
            4'b0000, _, 3'b111: ALU_control_signal = 4'b0000; // ANDI
            4'b0000, _, 3'b110: ALU_control_signal = 4'b0001; // ORI
            4'b0000, _, 3'b100: ALU_control_signal = 4'b0011; // XORI
            4'b0000, _, 3'b001: ALU_control_signal = 4'b0100; // SLLI
            4'b0000, _, 3'b101: ALU_control_signal = fun7 ? 4'b0111 : 4'b0105; // SRLI/SRAI

            // Load/Store instructions
            4'b0001, _, _: ALU_control_signal = 4'b0010; // ADD for address calculation

            // Branch instructions
            4'b0011, _, _: ALU_control_signal = 4'b011
            default: ALU_control_signal = 4'b0000; // Default case
        endcase
    end


endmodule